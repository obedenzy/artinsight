{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true, // Enable strict type checking
    "noEmit": true // Don't emit output files (handled by Vite)
  },
  "include": ["vite.config.ts", "tailwind.config.js", "postcss.config.js"] // Include config files that might use Node.js APIs
}
